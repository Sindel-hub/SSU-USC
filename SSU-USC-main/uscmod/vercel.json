{
  "redirects": [
    {
      "source": "/",
      "destination": "/home/home.html",
      "permanent": false
    },
    {
      "source": "/dashboard/election.html",
      "destination": "/dashboard/dashboard.html",
      "permanent": false
    },
    {
      "source": "/usc-admin/elections/:path*",
      "destination": "/usc-admin/overview/overview.html",
      "permanent": false
    },
    {
      "source": "/voting/:path*",
      "destination": "/dashboard/dashboard.html",
      "permanent": false
    }
  ],
  "buildCommand": "npm run build:hosted",
  "outputDirectory": "dist",
  "regions": [
    "sin1"
  ],
  "functions": {
    "api/management.js": {
      "maxDuration": 300
    }
  }
}
