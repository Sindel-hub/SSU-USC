rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function role() { return signedIn() && request.auth.token.role is string ? request.auth.token.role : ""; }
    function ownProfile() { return get(/databases/$(database)/documents/users/$(uid())).data; }
    function activeSchoolStanding(data) {
      return !("studentStanding" in data) || data.studentStanding == "active";
    }
    function activeProfileRole(expected) {
      return signedIn()
        && ownProfile().role == expected
        && ownProfile().isActive != false
        && ownProfile().accountStatus == "approved"
        && (expected == "admin" || activeSchoolStanding(ownProfile()));
    }
    // Administrator writes require the trusted custom claim plus an approved/active
    // administrator profile. The school-provisioned account model does not use
    // Firebase email_verified as a second authorization switch.
    function isAdmin() { return role() == "admin" && activeProfileRole("admin"); }
    // Officer/student authority is stored in the administrator-controlled Firestore profile.
    // Admin authority still requires the trusted Firebase custom claim.
    function isOfficer() { return activeProfileRole("officer"); }
    function isOfficerOrAdmin() { return isOfficer() || isAdmin(); }
    // Recommended default access per USC office/position. Explicit admin custom
    // permissions still override these defaults. This also repairs officers made
    // by the first RBAC revision, which stored only Dashboard + Organization.
    function officeDefaultHasPermission(permission) {
      return (ownProfile().officePosition == "President"
          && permission in [
            "dashboard.view",
            "complaints.view", "complaints.review", "complaints.classify", "complaints.feedback", "complaints.status", "complaints.report",
            "bulletin.manage", "events.manage", "programs.manage", "organization.view", "reports.generate"
          ])
        || (ownProfile().officePosition == "Vice President"
          && permission in [
            "dashboard.view",
            "elections.view", "elections.roster", "elections.review", "elections.results",
            "bulletin.manage", "events.manage", "organization.view", "reports.generate"
          ])
        || (ownProfile().officePosition == "Secretary"
          && permission in ["dashboard.view", "bulletin.manage", "events.manage", "programs.manage", "organization.view", "reports.generate"])
        || (ownProfile().officePosition in ["Treasurer", "Auditor"]
          && permission in ["dashboard.view", "organization.view", "reports.generate"])
        || (ownProfile().officePosition == "Public Relations Officer (PRO)"
          && permission in ["dashboard.view", "bulletin.manage", "events.manage", "programs.manage", "organization.view"])
        || (ownProfile().officePosition == "Business Manager"
          && permission in ["dashboard.view", "events.manage", "programs.manage", "organization.view", "reports.generate"])
        || (ownProfile().officePosition == "Sgt. at Arms"
          && permission in ["dashboard.view", "events.manage", "organization.view"])
        || (ownProfile().officePosition == "Department Representative"
          && permission in ["dashboard.view", "complaints.view", "complaints.review", "organization.view"]);
    }
    function officerHasPermission(permission) {
      return isAdmin() || (isOfficer() && (
        (("officerPermissionSource" in ownProfile())
          && ownProfile().officerPermissionSource == "custom"
          && ownProfile().officerPermissions is list
          && permission in ownProfile().officerPermissions)
        || (!("officerPermissionSource" in ownProfile()) || ownProfile().officerPermissionSource != "custom")
          && (
            (!("officerPermissions" in ownProfile()) && !officeDefaultHasPermission("dashboard.view"))
            || (ownProfile().officerPermissions is list && permission in ownProfile().officerPermissions)
            || officeDefaultHasPermission(permission)
          )
      ));
    }
    function isCanvasser() { return isAdmin() || (isOfficer() && ownProfile().canvasser == true); }
    function schoolStudent() {
      return activeProfileRole("student")
        && ownProfile().accountStatus == "approved"
        && ownProfile().schoolProvisioned == true;
    }
    function verifiedStudent() {
      return schoolStudent() && ownProfile().isVerifiedStudent == true;
    }
    function ownUser(userId) { return signedIn() && uid() == userId; }
    function ownStudentId(studentId) {
      return signedIn() && get(/databases/$(database)/documents/users/$(uid())).data.studentId == studentId;
    }
    function safeOwnProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "fullName", "profilePhoto", "profileUpdatedAt", "updatedAt", "updatedAtMs", "mustChangePassword"
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 120
        && (!("profilePhoto" in request.resource.data)
            || (request.resource.data.profilePhoto is string
                && request.resource.data.profilePhoto.size() <= 400000));
    }
    function electionDoc(electionId) {
      return get(/databases/$(database)/documents/elections/$(electionId)).data;
    }
    function electionExists(electionId) {
      return exists(/databases/$(database)/documents/elections/$(electionId));
    }
    function votingOpenByServer(electionId) {
  return electionExists(electionId)

    && electionDoc(electionId).finalized != true
    && electionDoc(electionId).archived != true

    // All candidacy applications must have a final decision.
    && electionDoc(electionId).candidateReviewComplete == true

    // Voting follows its own independent schedule.
    && request.time >= electionDoc(electionId).votingStart
    && request.time < electionDoc(electionId).votingEnd;
}
    function candidatePublishedByServer(electionId) {
  return electionExists(electionId)

    && request.time >=
      electionDoc(electionId).candidatePublicationStart

    && request.time <
      electionDoc(electionId).candidatePublicationEnd;
}

    function complaintRatePath() {
      return /databases/$(database)/documents/complaint_rate_limits/$(uid());
    }
    function complaintCooldownSatisfied() {
      return !exists(complaintRatePath())
        || get(complaintRatePath()).data.lastSubmittedAt <= request.time - duration.value(20, "s");
    }
    function complaintRateCommittedNow() {
      return getAfter(complaintRatePath()).data.studentUid == uid()
        && getAfter(complaintRatePath()).data.lastSubmittedAt == request.time;
    }
    function validComplaintClassification(value) {
      return value in ["Student Level", "Administrative Level", "Crisis Level"];
    }
    function validComplaintAttachment(data) {
      return data.attachmentType in [
          "", "image/jpeg", "image/png", "image/webp",
          "application/pdf", "application/msword",
          "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        ]
        && data.attachmentSize is int
        && data.attachmentSize >= 0
        && data.attachmentSize <= 5242880
        && (!data.attachmentType.matches("^image/") || data.attachmentSize <= 3145728);
    }
    function resultsReadableByServer(electionId) {
      return electionExists(electionId)
        && electionDoc(electionId).finalized == true
        && electionDoc(electionId).resultsPublished == true
        && request.time >= electionDoc(electionId).resultPublicationStart;
    }

    // Student email preferences, verification tokens, recovery bindings and
    // delivery logs were migrated to Supabase. No Firebase client access is
    // granted to the legacy email collections anymore.

    match /announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if officerHasPermission("bulletin.manage");
    }
    // Private post libraries. Public feeds continue to read only /announcements.
    match /archived_announcements/{postId} {
      allow read: if isOfficerOrAdmin();
      allow create: if officerHasPermission("bulletin.manage")
        && request.resource.data.post is map;
      allow delete: if officerHasPermission("bulletin.manage");
    }
    match /deleted_announcements/{postId} {
      allow read: if isOfficerOrAdmin();
      allow create: if officerHasPermission("bulletin.manage")
        && request.resource.data.post is map
        && request.resource.data.sourceCollection in ["announcements", "archived_announcements"]
        && request.resource.data.deletedAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time + duration.value(29, 'd')
        && request.resource.data.expiresAt <= request.time + duration.value(31, 'd');
      // Clients can restore only during the retention period; TTL purges later.
      allow delete: if officerHasPermission("bulletin.manage")
        && resource.data.expiresAt > request.time;
    }
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if officerHasPermission("events.manage");

      // Student event participation is self-service. A student can only create
      // or cancel their own portal registration while the officer-defined
      // registration window is still open. Students never edit the event itself.
      match /registrations/{userId} {
        allow read: if (schoolStudent() && ownUser(userId)) || isOfficerOrAdmin();
        allow create: if schoolStudent()
          && ownUser(userId)
          && get(/databases/$(database)/documents/events/$(eventId)).data.status == "Published"
          && get(/databases/$(database)/documents/events/$(eventId)).data.registrationMode == "internal"
          && get(/databases/$(database)/documents/events/$(eventId)).data.registrationDeadline is timestamp
          && request.time < get(/databases/$(database)/documents/events/$(eventId)).data.registrationDeadline
          && request.resource.data.keys().hasOnly([
            "eventId", "studentUid", "studentId", "fullName", "schoolEmail",
            "college", "program", "yearLevel", "status", "registeredAt"
          ])
          && request.resource.data.eventId == eventId
          && request.resource.data.studentUid == uid()
          && request.resource.data.studentId == ownProfile().studentId
          && request.resource.data.college == ownProfile().college
          && request.resource.data.program == ownProfile().program
          && request.resource.data.status == "registered"
          && request.resource.data.registeredAt == request.time;
        allow update: if false;
        allow delete: if officerHasPermission("events.manage")
          || (schoolStudent()
            && ownUser(userId)
            && get(/databases/$(database)/documents/events/$(eventId)).data.registrationMode == "internal"
            && get(/databases/$(database)/documents/events/$(eventId)).data.registrationDeadline is timestamp
            && request.time < get(/databases/$(database)/documents/events/$(eventId)).data.registrationDeadline);
      }
    }

    match /programs/{programId} {
      allow read: if true;
      allow create, update, delete: if officerHasPermission("programs.manage");

      // External program participation mirrors event self-registration but is
      // stored separately so outside-university programs remain independently managed.
      match /registrations/{userId} {
        allow read: if (schoolStudent() && ownUser(userId)) || isOfficerOrAdmin();
        allow create: if schoolStudent()
          && ownUser(userId)
          && get(/databases/$(database)/documents/programs/$(programId)).data.status == "Published"
          && get(/databases/$(database)/documents/programs/$(programId)).data.registrationMode == "internal"
          && get(/databases/$(database)/documents/programs/$(programId)).data.registrationDeadline is timestamp
          && request.time < get(/databases/$(database)/documents/programs/$(programId)).data.registrationDeadline
          && request.resource.data.keys().hasOnly([
            "programId", "studentUid", "studentId", "fullName", "schoolEmail",
            "college", "program", "yearLevel", "status", "registeredAt"
          ])
          && request.resource.data.programId == programId
          && request.resource.data.studentUid == uid()
          && request.resource.data.studentId == ownProfile().studentId
          && request.resource.data.college == ownProfile().college
          && request.resource.data.program == ownProfile().program
          && request.resource.data.status == "registered"
          && request.resource.data.registeredAt == request.time;
        allow update: if false;
        allow delete: if officerHasPermission("programs.manage")
          || (schoolStudent()
            && ownUser(userId)
            && get(/databases/$(database)/documents/programs/$(programId)).data.registrationMode == "internal"
            && get(/databases/$(database)/documents/programs/$(programId)).data.registrationDeadline is timestamp
            && request.time < get(/databases/$(database)/documents/programs/$(programId)).data.registrationDeadline);
      }
    }

    // User profiles: users can change display-only profile fields. Roles, eligibility,
    // Student IDs, account status, and officer privileges are server-controlled.
    match /users/{userId} {
      allow read: if ownUser(userId) || isAdmin();
      // Browser provisioning is create-only and may create ordinary school-provisioned
      // student or officer profiles. It can never create a System Administrator.
      allow create: if isAdmin()
        && request.resource.data.uid == userId
        && request.resource.data.role in ["student", "officer"]
        && request.resource.data.accountStatus == "approved"
        && request.resource.data.schoolProvisioned == true
        && request.resource.data.yearLevel is string
        && request.resource.data.yearLevel.size() >= 2
        && request.resource.data.yearLevel.size() <= 40
        && request.resource.data.studentStanding in ["active", "leave", "inactive", "graduated", "transferred", "withdrawn", "eliminated"]
        && request.resource.data.isActive == (request.resource.data.studentStanding == "active")
        && request.resource.data.isVerifiedStudent is bool
        && (!("candidacyApproved" in request.resource.data) || request.resource.data.candidacyApproved is bool)
        && (request.resource.data.studentStanding == "active" || request.resource.data.isVerifiedStudent == false)
        && request.resource.data.studentId is string
        && request.resource.data.studentId.matches("^[0-9]{6}$")
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && (request.resource.data.role == "student"
          || (request.resource.data.officePosition is string
            && request.resource.data.officePosition.size() >= 2
            && request.resource.data.officePosition.size() <= 120
            && request.resource.data.officerPermissions is list
            && request.resource.data.officerPermissions.size() <= 16
            && "dashboard.view" in request.resource.data.officerPermissions
            && (!("officerPermissionSource" in request.resource.data)
              || request.resource.data.officerPermissionSource in ["position-default", "custom"])));
      allow update: if (ownUser(userId) && safeOwnProfileUpdate())
        || (isAdmin()
          && resource.data.role != "admin"
          && request.resource.data.role in ["student", "officer"]
          && request.resource.data.studentId == resource.data.studentId
          && (!("yearLevel" in request.resource.data)
            || (request.resource.data.yearLevel is string
              && request.resource.data.yearLevel.size() <= 40))
          && (!("studentStanding" in request.resource.data)
            || request.resource.data.studentStanding in ["active", "leave", "inactive", "graduated", "transferred", "withdrawn", "eliminated"])
          && (!("studentStanding" in request.resource.data)
            || request.resource.data.isActive == (request.resource.data.studentStanding == "active"))
          && (!("studentStanding" in request.resource.data)
            || request.resource.data.studentStanding == "active"
            || request.resource.data.isVerifiedStudent == false)
          && (!("candidacyApproved" in request.resource.data) || request.resource.data.candidacyApproved is bool)
          && (!("officerPermissions" in request.resource.data)
            || (request.resource.data.officerPermissions is list
              && request.resource.data.officerPermissions.size() <= 16
              && (request.resource.data.role != "officer" || "dashboard.view" in request.resource.data.officerPermissions)))
          && (!("officerPermissionSource" in request.resource.data)
            || request.resource.data.officerPermissionSource in ["", "position-default", "custom"]));
      allow delete: if false;
    }

    // Student sign-in analytics. Each student owns exactly one aggregate record.
    // Students may only increment their own sign-in counter and the department/program
    // must match the administrator-controlled user profile. Officers/admins can read
    // the aggregate collection for dashboard analytics, but students cannot list it.
    match /student_signin_stats/{studentUid} {
      allow get: if signedIn() && (uid() == studentUid || isOfficerOrAdmin());
      allow list: if isOfficerOrAdmin();

      // Normal student login: create the first real tracked sign-in.
      allow create: if (schoolStudent()
        && uid() == studentUid
        && request.resource.data.keys().hasOnly([
          "studentUid", "department", "program", "signInCount", "firstSignInAt", "lastSignInAt"
        ])
        && request.resource.data.studentUid == uid()
        && request.resource.data.department == ownProfile().college
        && request.resource.data.program == ownProfile().program
        && request.resource.data.signInCount == 1
        && request.resource.data.firstSignInAt == request.time
        && request.resource.data.lastSignInAt == request.time)

        // One-time System Administrator backfill for student accounts that existed
        // before sign-in analytics was introduced. A legacy account with no stored
        // login timestamp is imported with signInCount=0 rather than inventing activity.
        || (isAdmin()
          && exists(/databases/$(database)/documents/users/$(studentUid))
          && get(/databases/$(database)/documents/users/$(studentUid)).data.role == "student"
          && request.resource.data.keys().hasOnly([
            "studentUid", "department", "program", "signInCount", "firstSignInAt", "lastSignInAt",
            "accountCreatedAtMs", "legacyBackfill", "backfilledAt"
          ])
          && request.resource.data.keys().hasAll([
            "studentUid", "department", "program", "signInCount", "firstSignInAt", "lastSignInAt",
            "accountCreatedAtMs", "legacyBackfill", "backfilledAt"
          ])
          && request.resource.data.studentUid == studentUid
          && request.resource.data.department == get(/databases/$(database)/documents/users/$(studentUid)).data.college
          && request.resource.data.program == get(/databases/$(database)/documents/users/$(studentUid)).data.program
          && request.resource.data.signInCount in [0, 1]
          && request.resource.data.accountCreatedAtMs is int
          && request.resource.data.accountCreatedAtMs >= 0
          && request.resource.data.legacyBackfill == true
          && request.resource.data.backfilledAt == request.time
          && ((request.resource.data.signInCount == 0
                && request.resource.data.firstSignInAt == null
                && request.resource.data.lastSignInAt == null)
              || (request.resource.data.signInCount == 1
                && request.resource.data.firstSignInAt is timestamp
                && request.resource.data.lastSignInAt is timestamp)));

      allow update: if schoolStudent()
        && uid() == studentUid
        && resource.data.studentUid == uid()
        && request.resource.data.studentUid == uid()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "department", "program", "signInCount", "firstSignInAt", "lastSignInAt"
        ])
        && request.resource.data.department == ownProfile().college
        && request.resource.data.program == ownProfile().program
        && request.resource.data.signInCount == resource.data.signInCount + 1
        && request.resource.data.lastSignInAt == request.time
        && ((resource.data.signInCount == 0
              && request.resource.data.firstSignInAt == request.time)
            || (resource.data.signInCount > 0
              && request.resource.data.firstSignInAt == resource.data.firstSignInAt));
      allow delete: if false;
    }

    // Complaints are private to the submitting student and authorized officers/admins.
    // Submission is paired atomically with a per-student rate-limit record. This avoids
    // duplicate-click floods and distributes concurrent writes across user-specific docs.
    match /complaints/{complaintId} {
      // Exact GETs may probe a not-yet-created random ID so transaction retries can
      // safely determine whether an earlier attempt already committed. Existing
      // complaints remain readable only to their owner or authorized staff.
      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/complaints/$(complaintId))
        || resource.data.studentUid == uid()
        || isOfficerOrAdmin()
      );
      allow list: if signedIn() && (resource.data.studentUid == uid() || isOfficerOrAdmin());
      allow create: if schoolStudent()
        && request.resource.data.studentUid == uid()
        && request.resource.data.studentId == get(/databases/$(database)/documents/users/$(uid())).data.studentId
        && request.resource.data.studentEmail == get(/databases/$(database)/documents/users/$(uid())).data.email
        && request.resource.data.status == "Submitted"
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 3
        && request.resource.data.subject.size() <= 120
        && request.resource.data.details is string
        && request.resource.data.details.size() >= 5
        && request.resource.data.details.size() <= 1000
        && validComplaintAttachment(request.resource.data)
        && complaintCooldownSatisfied()
        && complaintRateCommittedNow()
        && request.resource.data.keys().hasOnly([
          "complaintRef", "submissionId", "studentUid", "studentId", "studentName", "studentEmail", "studentDepartment",
          "subject", "category", "incidentDate", "details", "status", "createdAt", "updatedAt",
          "attachmentName", "attachmentPath", "attachmentStorageBucket", "attachmentStoragePath",
          "attachmentType", "attachmentSize", "thread"
        ]);
      // Browser-only complaint review updates are restricted to authorized officers/admins.
      // Officers may assign the review classification, advance the workflow, and append
      // one official feedback entry at a time. Students remain submit-only.
      allow update: if officerHasPermission("complaints.review")
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "classification", "updatedAt", "thread"])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["status"]) || officerHasPermission("complaints.status"))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["classification"]) || officerHasPermission("complaints.classify"))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["thread"]) || officerHasPermission("complaints.feedback") || officerHasPermission("complaints.classify"))
        && request.resource.data.status in ["Submitted", "Under Review", "In Progress", "Resolved", "Closed"]
        && request.resource.data.updatedAt == request.time
        && (!(request.resource.data.diff(resource.data).affectedKeys().hasAny(["classification"]))
          || (("classification" in request.resource.data)
            && validComplaintClassification(request.resource.data.classification)))
        && (!(request.resource.data.status in ["In Progress", "Resolved", "Closed"])
          || (("classification" in request.resource.data)
            && validComplaintClassification(request.resource.data.classification)))
        && (!(request.resource.data.diff(resource.data).affectedKeys().hasAny(["thread"]))
          || (("classification" in request.resource.data)
            && validComplaintClassification(request.resource.data.classification)
            && request.resource.data.thread is list
            && resource.data.thread is list
            && request.resource.data.thread.size() == resource.data.thread.size() + 1
            && request.resource.data.thread.size() <= 200));
      // A complaint becomes deletable only after it has reached a terminal workflow state.
      allow delete: if officerHasPermission("complaints.status") && resource.data.status in ["Resolved", "Closed"];

      // Browser-only capstone attachment storage. Files are split into bounded chunks
      // under the complaint, so they inherit the complaint's student/officer privacy
      // instead of depending on a Cloud Function or public storage URL.
      match /attachmentChunks/{chunkId} {
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/complaints/$(complaintId)).data.studentUid == uid()
          || isOfficerOrAdmin()
        );
        allow create: if signedIn()
          && getAfter(/databases/$(database)/documents/complaints/$(complaintId)).data.studentUid == uid()
          && request.resource.data.studentUid == uid()
          && request.resource.data.index is int
          && request.resource.data.index >= 0
          && request.resource.data.index <= 30
          && request.resource.data.payload is string
          && request.resource.data.payload.size() > 0
          && request.resource.data.payload.size() <= 850000
          && request.resource.data.keys().hasOnly(["studentUid", "index", "payload"]);
        allow update: if false;
        allow delete: if isOfficerOrAdmin()
          && exists(/databases/$(database)/documents/complaints/$(complaintId))
          && get(/databases/$(database)/documents/complaints/$(complaintId)).data.status in ["Resolved", "Closed"];
      }
    }

    // Minimal immutable complaint case audit. No complaint body or voter-sensitive data is stored here.
    match /complaint_case_logs/{logId} {
      allow read: if isAdmin();
      allow create: if officerHasPermission("complaints.review")
        && request.resource.data.actorUid == uid()
        && request.resource.data.action in ["COMPLAINT_STATUS_UPDATED", "COMPLAINT_REVIEW_UPDATED", "COMPLAINT_DELETED"]
        && request.resource.data.complaintId is string
        && request.resource.data.complaintId.size() > 0
        && request.resource.data.complaintRef is string
        && request.resource.data.statusBefore is string
        && request.resource.data.statusAfter is string
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasAll([
          "actorUid", "actorEmail", "action", "complaintId", "complaintRef",
          "statusBefore", "statusAfter", "source", "createdAt"
        ])
        && request.resource.data.keys().hasOnly([
          "actorUid", "actorEmail", "action", "complaintId", "complaintRef",
          "statusBefore", "statusAfter", "classificationBefore", "classificationAfter", "source", "createdAt"
        ])
        && (!(request.resource.data.keys().hasAny(["classificationBefore"]))
          || request.resource.data.classificationBefore in ["Pending Classification", "Student Level", "Administrative Level", "Crisis Level"])
        && (!(request.resource.data.keys().hasAny(["classificationAfter"]))
          || request.resource.data.classificationAfter in ["Pending Classification", "Student Level", "Administrative Level", "Crisis Level"]);
      allow update, delete: if false;
    }

    // Per-user complaint cooldown. A student can only advance their own timestamp to
    // the current server request time. The complaint create rule requires this write
    // in the same transaction, so the cooldown cannot be skipped by the browser.
    match /complaint_rate_limits/{userId} {
      allow get: if signedIn() && userId == uid();
      allow list: if false;
      allow create: if schoolStudent()
        && userId == uid()
        && request.resource.data.keys().hasOnly(["studentUid", "lastSubmittedAt"])
        && request.resource.data.studentUid == uid()
        && request.resource.data.lastSubmittedAt == request.time;
      allow update: if schoolStudent()
        && userId == uid()
        && resource.data.studentUid == uid()
        && request.resource.data.studentUid == uid()
        && request.resource.data.keys().hasOnly(["studentUid", "lastSubmittedAt"])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastSubmittedAt"])
        && request.resource.data.lastSubmittedAt == request.time;
      allow delete: if false;
    }

    // Browser-managed capstone election workflow. Firestore Rules remain the final
    // authorization/time gate so the UI does not need a Cloud Function for normal use.
    match /election_config/{docId} {
      allow read: if signedIn();
      allow create, update: if officerHasPermission("elections.view")
        && docId == "current"
        && request.resource.data.electionId is string
        && request.resource.data.electionId.matches("^[a-z0-9][a-z0-9-]{2,79}$");
      allow delete: if officerHasPermission("elections.view") && docId == "current";
    }
    match /elections/{electionId} {
      allow read: if signedIn();
      allow create: if officerHasPermission("elections.view")
        && request.resource.data.title is string
        && request.resource.data.registrationStart is timestamp
        && request.resource.data.registrationEnd is timestamp
        && request.resource.data.applicationReviewStart is timestamp
        && request.resource.data.applicationReviewEnd is timestamp
        && request.resource.data.candidatePublicationStart is timestamp
        && request.resource.data.candidatePublicationEnd is timestamp
        && request.resource.data.votingStart is timestamp
        && request.resource.data.votingEnd is timestamp
        && request.resource.data.resultPublicationStart is timestamp
        && request.resource.data.resultPublicationEnd is timestamp
        && request.resource.data.registrationStart < request.resource.data.registrationEnd
        && request.resource.data.registrationEnd <= request.resource.data.applicationReviewStart
        && request.resource.data.applicationReviewStart < request.resource.data.applicationReviewEnd
        && request.resource.data.applicationReviewEnd <= request.resource.data.candidatePublicationStart
&& request.resource.data.candidatePublicationStart < request.resource.data.candidatePublicationEnd

// Voting depends on completed review scheduling,
// NOT Candidate Publication closing.
        && request.resource.data.applicationReviewEnd <= request.resource.data.votingStart
        && request.resource.data.votingStart < request.resource.data.votingEnd
        && request.resource.data.votingEnd <= request.resource.data.resultPublicationStart
        && request.resource.data.resultPublicationStart < request.resource.data.resultPublicationEnd;
      allow update: if officerHasPermission("elections.view")
        && resource.data.archived != true
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "registrationStart", "registrationEnd", "applicationReviewStart", "applicationReviewEnd",
            "candidatePublicationStart", "candidatePublicationEnd", "votingStart", "votingEnd",
            "resultPublicationStart", "resultPublicationEnd", "title"
          ]) || officerHasPermission("elections.view"))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["candidateReviewComplete", "candidateReviewCompletedAt", "candidateReviewCompletedByUid"]) || officerHasPermission("elections.review"))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(["finalized", "resultsPublished", "finalizedAt", "finalizedByUid", "resultsPublishedAt"]) || officerHasPermission("elections.results"))
        && (request.resource.data.finalized == resource.data.finalized || isCanvasser())
        && (request.resource.data.resultsPublished == resource.data.resultsPublished || isCanvasser())
        && (request.resource.data.archived == resource.data.archived || isAdmin())
        && (request.resource.data.archived != true || request.resource.data.resultsPublished == true)
        && (request.resource.data.resultsPublished != true || request.resource.data.finalized == true)
        && (request.resource.data.finalized != true || request.time >= resource.data.votingEnd)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "registrationStart", "registrationEnd", "applicationReviewStart", "applicationReviewEnd",
            "candidatePublicationStart", "candidatePublicationEnd", "votingStart", "votingEnd",
            "resultPublicationStart", "resultPublicationEnd"
          ])
          || officerHasPermission("elections.view")
          || isAdmin());
      allow delete: if false;

      match /rosterImports/{importId} {
        allow read, create, update: if officerHasPermission("elections.roster");
        allow delete: if false;
      }

      match /voterRoster/{studentId} {
        allow read: if officerHasPermission("elections.roster") || (verifiedStudent() && ownStudentId(studentId));
        allow create, update: if officerHasPermission("elections.roster")
          && request.resource.data.studentId == studentId
          && request.resource.data.eligible is bool
          && (!("studentStanding" in request.resource.data)
            || request.resource.data.studentStanding == "active"
            || request.resource.data.eligible == false);
        allow delete: if officerHasPermission("elections.roster");
      }

      // Participation status contains no candidate selections. The browser transaction
      // must create this record together with the anonymous ballot during the voting window.
      match /voterStatus/{userId} {
        allow read: if ownUser(userId) || isAdmin();
        allow create: if schoolStudent()
          && userId == uid()
          && votingOpenByServer(electionId)
          && request.resource.data.hasVoted == true
          && request.resource.data.studentId == ownProfile().studentId
          && request.resource.data.receiptReference is string
          && request.resource.data.receiptReference.size() >= 8;
        allow update, delete: if false;
      }

      match /applications/{applicantUid} {
        allow read: if ownUser(applicantUid) || isOfficerOrAdmin();
        allow create: if schoolStudent()
          && ownProfile().candidacyApproved == true
          && applicantUid == uid()
          && request.time >= electionDoc(electionId).registrationStart
          && request.time < electionDoc(electionId).registrationEnd
          && request.resource.data.applicantUid == uid()
          && request.resource.data.studentId == ownProfile().studentId
          && request.resource.data.status == "Under Review"
          && request.resource.data.position in ["President", "Vice President", "Secretary", "Treasurer", "Auditor", "Public Relations Officer", "Business Manager", "Sgt. at Arms", "Department Representative"];
        allow update: if officerHasPermission("elections.review")
          && request.time >= electionDoc(electionId).applicationReviewStart
          && request.time < electionDoc(electionId).applicationReviewEnd
          && resource.data.status == "Under Review"
          && request.resource.data.status in ["Approved", "Rejected"];

        // Authorized election reviewers may manually remove pending candidate applications.
        // This supports the officer "Remove Candidate" action while keeping access controlled.
        allow delete: if (isOfficerOrAdmin() || role() == "officer" || role() == "admin")
          && resource.data.status == "Under Review";
      }

      match /candidates/{candidateId} {
  allow read: if isOfficerOrAdmin()
    || (
      signedIn()
      && (
        candidatePublishedByServer(electionId)
        || votingOpenByServer(electionId)
      )
    );
        allow create: if officerHasPermission("elections.review")
          && request.time >= electionDoc(electionId).applicationReviewStart
          && request.time < electionDoc(electionId).applicationReviewEnd
          && request.resource.data.candidateId == candidateId
          && request.resource.data.approved == true
          && request.resource.data.position in ["President", "Vice President", "Secretary", "Treasurer", "Auditor", "Public Relations Officer", "Business Manager", "Sgt. at Arms", "Department Representative"];
        allow update: if false;
        // Authorized election reviewers/admins may remove a candidate application
        // while preserving the election audit trail handled by the application layer.
        allow delete: if officerHasPermission("elections.review");
      }

      // Capstone browser ballot. The ballot document itself contains only candidate IDs
      // and schema metadata. Identity remains in the separate voterStatus record.
      match /ballots/{ballotId} {
        allow read: if isCanvasser()
          && electionDoc(electionId).finalized == true
          && request.time >= electionDoc(electionId).votingEnd;
        allow create: if schoolStudent()
          && votingOpenByServer(electionId)
          && !exists(/databases/$(database)/documents/elections/$(electionId)/voterStatus/$(uid()))
          && getAfter(/databases/$(database)/documents/elections/$(electionId)/voterStatus/$(uid())).data.hasVoted == true
          && request.resource.data.schemaVersion == 2
          && request.resource.data.recordedAt == request.time
          && request.resource.data.keys().hasOnly(["selections", "schemaVersion", "recordedAt"])
          && request.resource.data.selections is map
          && request.resource.data.selections.keys().hasOnly(["President", "Vice President", "Secretary", "Treasurer", "Auditor", "Public Relations Officer", "Business Manager", "Sgt. at Arms", "Department Representative"])
          && request.resource.data.selections.keys().hasAll(["President", "Vice President", "Secretary", "Treasurer", "Auditor", "Public Relations Officer", "Business Manager", "Sgt. at Arms", "Department Representative"]);
        allow update, delete: if false;
      }

      match /turnout/{docId} {
        allow read: if signedIn();
        allow create: if officerHasPermission("elections.roster") || officerHasPermission("elections.results");
        allow update: if officerHasPermission("elections.roster") || officerHasPermission("elections.results")
          || (schoolStudent()
            && docId == "public"
            && votingOpenByServer(electionId)
            && ownProfile().college is string
            && ownProfile().college.size() > 0
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["ballotsCast", "departmentVotes", "updatedAt"])
            && request.resource.data.ballotsCast == resource.data.ballotsCast + 1
            && request.resource.data.eligibleVoters == resource.data.eligibleVoters
            && request.resource.data.updatedAt == request.time
            && request.resource.data.departmentVotes is map
            && (
              (!("departmentVotes" in resource.data)
                && request.resource.data.departmentVotes.keys().hasOnly([ownProfile().college])
                && request.resource.data.departmentVotes[ownProfile().college] == 1)
              ||
              (("departmentVotes" in resource.data)
                && request.resource.data.departmentVotes.diff(resource.data.departmentVotes).affectedKeys().hasOnly([ownProfile().college])
                && (
                  (!(ownProfile().college in resource.data.departmentVotes)
                    && request.resource.data.departmentVotes[ownProfile().college] == 1)
                  ||
                  ((ownProfile().college in resource.data.departmentVotes)
                    && request.resource.data.departmentVotes[ownProfile().college] == resource.data.departmentVotes[ownProfile().college] + 1)
                ))
            ));
        allow delete: if false;
      }

      match /privateTallies/{candidateId} {
        allow read: if isCanvasser()
          && electionDoc(electionId).finalized == true
          && request.time >= electionDoc(electionId).votingEnd;
        allow write: if false;
      }

      match /results/{resultId} {
        allow read: if (isCanvasser()
            && electionDoc(electionId).finalized == true
            && request.time >= electionDoc(electionId).votingEnd)
          || resultsReadableByServer(electionId);
        allow create, update: if officerHasPermission("elections.results") && isCanvasser()
          && resultId == "official"
          && electionDoc(electionId).finalized == true
          && request.time >= electionDoc(electionId).resultPublicationStart;
        allow delete: if false;
      }
    }

    // Browser-only file storage for the Spark/no-backend capstone build.
    // Public event/announcement/candidate photos may be read by any visitor;
    // private candidacy documents stay restricted to their owner and authorized staff.
    match /browser_files/{fileId} {
      allow read: if resource.data.visibility == "public"
        || (signedIn() && resource.data.kind == "candidate-photo")
        || (signedIn() && (resource.data.ownerUid == uid() || isOfficerOrAdmin()));
      allow create: if signedIn()
        && request.resource.data.ownerUid == uid()
        && request.resource.data.kind in ["event-media", "program-media", "announcement-media", "candidate-photo", "candidate-document"]
        && request.resource.data.visibility in ["public", "private"]
        && request.resource.data.size is int
        && request.resource.data.size > 0
        && request.resource.data.size <= 6291456
        && request.resource.data.chunkCount is int
        && request.resource.data.chunkCount > 0
        && request.resource.data.chunkCount <= 24
        && ((request.resource.data.kind in ["event-media", "program-media", "announcement-media"] && isOfficerOrAdmin())
          || (request.resource.data.kind in ["candidate-photo", "candidate-document"] && verifiedStudent()));
      allow update: if false;
      allow delete: if signedIn() && (resource.data.ownerUid == uid() || isOfficerOrAdmin());

      match /chunks/{chunkId} {
        allow read: if get(/databases/$(database)/documents/browser_files/$(fileId)).data.visibility == "public"
          || (signedIn() && get(/databases/$(database)/documents/browser_files/$(fileId)).data.kind == "candidate-photo")
          || (signedIn() && (get(/databases/$(database)/documents/browser_files/$(fileId)).data.ownerUid == uid() || isOfficerOrAdmin()));
        allow create: if signedIn()
          && getAfter(/databases/$(database)/documents/browser_files/$(fileId)).data.ownerUid == uid()
          && request.resource.data.index is int
          && request.resource.data.index >= 0
          && request.resource.data.index < 24
          && request.resource.data.payload is string
          && request.resource.data.payload.size() > 0
          && request.resource.data.payload.size() <= 700000;
        allow update: if false;
        allow delete: if signedIn()
          && (get(/databases/$(database)/documents/browser_files/$(fileId)).data.ownerUid == uid() || isOfficerOrAdmin());
      }
    }

    // Free Spark school-login aliases. Only exact document GETs are public;
    // collection listing and all browser writes remain denied. Alias documents
    // contain only the internal Firebase Auth login address, not passwords.
    match /login_aliases/{aliasId} {
      allow get: if true;
      allow list: if isAdmin();
      function validAlias() {
        return isAdmin()
          && request.resource.data.authEmail is string
          && request.resource.data.authEmail.size() <= 200
          && request.resource.data.kind in ["studentId", "institutionalEmail"];
      }
      allow create: if validAlias();
      // An admin may refresh an alias for its owner, never redirect another
      // account's institutional login during concurrent manual provisioning.
      allow update: if validAlias()
        && (("uid" in resource.data && request.resource.data.uid == resource.data.uid)
          || (!("uid" in resource.data) && request.resource.data.authEmail == resource.data.authEmail));
      allow delete: if isAdmin();
    }

    // Ownership tokens are hashed and consumed only by the trusted email service.
    match /institutional_email_requests/{userId} {
      allow read, write: if false;
    }

    // Identity and uniqueness records used by the school account provisioner.
    // Only the trusted System Administrator can mutate them.
    match /student_masterlist/{studentId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.studentId == studentId;
      allow delete: if isAdmin();
    }
    match /student_id_claims/{studentId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && !exists(/databases/$(database)/documents/student_id_claims/$(studentId))
        && request.resource.data.studentId == studentId
        && request.resource.data.uid is string;
      allow update: if isAdmin()
        && resource.data.uid == request.resource.data.uid
        && request.resource.data.studentId == studentId;
      allow delete: if isAdmin();
    }
    // Duplicate-name reservations used by student and officer provisioning.
    // A reservation is create-only so a concurrent registration cannot replace it.
    match /student_name_claims/{nameKey} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && !exists(/databases/$(database)/documents/student_name_claims/$(nameKey))
        && nameKey.matches("^[a-f0-9]{64}$")
        && request.resource.data.nameKey == nameKey
        && request.resource.data.uid is string
        && request.resource.data.uid.size() > 0
        && request.resource.data.studentId is string
        && request.resource.data.studentId.matches("^[0-9]{6}$")
        && request.resource.data.normalizedName is string
        && request.resource.data.normalizedName.size() > 0
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.accountRole in ["student", "officer"]
        && request.resource.data.createdBy == uid();
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /school_accounts/{studentId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.studentId == studentId
        && request.resource.data.uid is string;
      allow delete: if isAdmin();
    }

    // Immutable administrator audit stream. Admins may append events, but no browser
    // client may alter or delete an existing event.
    match /audit_logs/{logId} {

  allow read: if isAdmin();

  /*
   * Admins can write normal audit records.
   *
   * Officers may ONLY create the specific
   * Election Schedule Save audit entry.
   */
  allow create: if
    request.resource.data.actorUid == uid()
    && request.resource.data.action is string
    && (
      isAdmin()

      ||

      (
        isOfficer()
        && request.resource.data.action in ["ELECTION_SCHEDULE_SAVE", "ELECTION_SCHEDULE_DELETE"]
        && request.resource.data.source == "browser-election-runtime"
        && request.resource.data.target is string
        && request.resource.data.target.matches(
          "^elections/[a-z0-9][a-z0-9-]{2,79}$"
        )
        && request.resource.data.createdAt == request.time
      )
    );

  allow update, delete: if false;
}

    // Legacy election collections are fail-closed. Migrate old records before production use.
    match /votes/{docId} { allow read, write: if false; }
    match /candidate_applications/{docId} { allow read, write: if false; }
    match /election_settings/{docId} { allow read, write: if false; }
    match /role_logs/{docId} { allow read: if isAdmin(); allow write: if false; }

    // Everything not explicitly listed is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
